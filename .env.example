# Application Runtime Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Configuration
POSTGRES_DB=walletapp_db
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=wallet_secret_password
POSTGRES_PORT=5432

# Keycloak Identity Provider Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret_password
KEYCLOAK_PORT=8081
JWKS_ISSUER_URI=http://localhost:8081/realms/walletapp-realm

# Rate Limiting Configuration (In-Memory Token Bucket)
APP_SECURITY_RATE_LIMIT_ENABLED=true
APP_SECURITY_RATE_LIMIT_CAPACITY=10
APP_SECURITY_RATE_LIMIT_REFILL_TOKENS=10
APP_SECURITY_RATE_LIMIT_REFILL_DURATION_SECONDS=60